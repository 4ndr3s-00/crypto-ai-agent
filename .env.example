# ==============================================================================
# Crypto AI Agent Platform — Variables de Entorno
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MinIO Data Lake (S3 Storage)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_LAKE=market-lake

# Credenciales de Servicio MinIO
INGESTION_MINIO_USER=ingestion_service
INGESTION_MINIO_PASSWORD=ingestion_secure_pass123
API_MINIO_USER=api_service
API_MINIO_PASSWORD=api_secure_pass123

# ------------------------------------------------------------------------------
# 2. Exchange & Ingesta (Binance Public API)
# ------------------------------------------------------------------------------
BINANCE_API_BASE=https://data-api.binance.vision
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
MARKET_CACHE_TTL_SECONDS=5.0
MARKET_REQUEST_TIMEOUT_SECONDS=10.0
CATCHUP_MAX_DAYS=60

# ------------------------------------------------------------------------------
# 3. Cerebro del Agente de IA e Inferencia
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0

# Fallback Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Router Semántico
SEMANTIC_ROUTER_ENABLED=true
SEMANTIC_ROUTER_THRESHOLD=0.68

# ------------------------------------------------------------------------------
# 4. Backend Serving API & Frontend
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8001
